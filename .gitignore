vikings_keymap_editor
.obj-keymap-editor/
# the build trees: .obj (the game), .obj-test, .obj-headless[-test], .obj-win[-test], -nogen / -bounds suffixes
/.obj*/
# the project's private working rules, never committed
/CLAUDE.md
# assets_raw/ is the DATA.DAT extraction (tools/data/extract_datadat.py) — never committed,
# except the two inputs of the console content build (tools/assets/build_content.py):
# the chunk role map and the DSL text of the six world scripts (a byte dump cannot
# regenerate them: chunk_map.py and lvs_full.py need the runtime traces of the canon).
assets_raw/*
!assets_raw/chunk_map.json
!assets_raw/lvs/
assets_raw/lvs/*
!assets_raw/lvs/*.lvsf
/assets/
# the console content pack built by tools/assets/build_content.py (make content)
/content/
# mod packages exported by tools/assets/edit_server.py --export-mod: console-derived data, never committed
/mods/
# the Blizzard Arcade Collection's translation files (the language banks of the content pack): the user's, never committed
/locale.strings
/lv_snes_strings.json
/bac/
__pycache__/

# Nix GC-root symlinks (toolchain pins)
/.nix-sdl2-dev-root
/.nix-tc-*

# UX stage 6: fetched from nixpkgs by tools/assets/unifont_glyphs.py, not bundled
fonts/unifont.otf

# UX stage 11: the SC-55 option reads the module ROMs from here — Roland's images, never committed
roms/
